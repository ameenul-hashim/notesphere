# ---------------------------------------------------------------------------
# NoteSphere Production & Development Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Environment: "development" (default) or "production"
DJANGO_ENV=production

# Django Secret Key (generate using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=your-production-django-secret-key-here

# "True" in dev, "False" in production
DJANGO_DEBUG=False

# Comma-separated hostnames allowed to serve the app (e.g. notesphere.pages.dev, yourdomain.com)
DJANGO_ALLOWED_HOSTS=notesphere.com,notesphere.pages.dev,localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL - see config/integrations/neon.py)
# ---------------------------------------------------------------------------
DB_ENGINE=postgresql
PGDATABASE=notesphere
PGUSER=your-db-user
PGPASSWORD=your-neon-db-password-here
PGHOST=ep-example-123456.us-east-2.aws.neon.tech
PGPORT=5432

# ---------------------------------------------------------------------------
# Firebase (Cloud Firestore — Realtime features ONLY)
# Frontend Web SDK config (safe to expose to browser)
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=your-web-api-key-from-firebase-console
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id

# Backend Admin SDK — path to gitignored service account JSON
# NEVER commit the JSON file. Default: config/firebase/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase/firebase-service-account.json

# ---------------------------------------------------------------------------
# Email — Brevo Transactional SMTP Relay
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-login-email@example.com
BREVO_SMTP_PASSWORD=your-brevo-smtp-key
BREVO_FROM_NAME=NoteSphere
BREVO_FROM_EMAIL=noreply@notesphere.com
SUPPORT_EMAIL=noreply@notesphere.com

# ---------------------------------------------------------------------------
# Supabase Storage (Thumbnails & PDF assets)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=thumbnails
