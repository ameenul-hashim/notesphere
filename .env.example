# ---------------------------------------------------------------------------
# NoteSphere environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Environment: "development" (default) or "production"
DJANGO_ENV=development

# Set a long random value in production: https://djecrety.ir or
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" or "False" (must be False in production)
DJANGO_DEBUG=True

# Comma-separated hostnames allowed to serve the app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL - see config/integrations/neon.py)
# ---------------------------------------------------------------------------
DB_ENGINE=postgresql
PGDATABASE=
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=5432

# ---------------------------------------------------------------------------
# Supabase (NOT connected yet - placeholders for future use)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Email (dev uses console backend by default; SMTP only when these are set)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=NoteSphere <noreply@notesphere.local>
