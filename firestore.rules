rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get the user's role from the users collection
    function getUserRole() {
      let userDoc = get(/databases/$(database)/documents/users/user_$(request.auth.uid));
      return userDoc.exists ? userDoc.data.role : null;
    }

    // Helper function to check if the user is an ADMIN
    function isAdmin() {
      return getUserRole() == 'ADMIN';
    }

    // A presence session is "stale" when its heartbeat predates the stale
    // timeout. Used to allow the elected global sweeper to delete dead
    // sessions of other users while making it impossible to touch a session
    // that is still heartbeatting (i.e. an online user can never be taken
    // offline by another client).
    function isStaleSession() {
      return resource.data.heartbeat != null
          && resource.data.heartbeat < request.time - duration.value(90, 's');
    }

    // ----------------------------------------------------------------------
    // USERS COLLECTION (Presence)
    // ----------------------------------------------------------------------
    match /users/{userId} {
      // Anyone authenticated can read user presence
      allow read: if isAuthenticated();

      // Users can only create/update/delete their own presence document
      allow create: if isAuthenticated() && userId == 'user_' + request.auth.uid;
      allow update: if isAuthenticated() && userId == 'user_' + request.auth.uid;
      allow delete: if isAuthenticated() && userId == 'user_' + request.auth.uid;
    }

    // ----------------------------------------------------------------------
    // PRESENCE SESSIONS (multi-tab / multi-device)
    // ----------------------------------------------------------------------
    // Collection-group capable match (also covers users/{userId}/sessions/...).
    // Owner: full control of their own sessions. Other clients: may only
    // DELETE sessions that are verifiably stale (the global sweeper), so
    // cleanup never compromises an online user.
    match /{path=**}/sessions/{sessionId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthenticated()
                    && resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() && (
          resource.data.user_id == request.auth.uid
          || isStaleSession()
        );
    }

    // ----------------------------------------------------------------------
    // COMMUNITY CHAT COLLECTION
    // ----------------------------------------------------------------------
    match /community_chat/{messageId} {
      // Anyone authenticated can read chat messages
      allow read: if isAuthenticated();

      // Anyone authenticated can create a message
      // Note: backend validation controls sender_id spoofing
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasAll(['sender_id', 'message', 'created_at'])
                    && request.resource.data.sender_id == request.auth.uid;

      // Update / Edit rules:
      // Admins can update any message.
      // Students can only update their own messages.
      allow update: if isAuthenticated() && (
        isAdmin() || resource.data.sender_id == request.auth.uid
      );

      // Delete rules:
      // Admins can delete any message.
      // Students can delete their own messages.
      allow delete: if isAuthenticated() && (
        isAdmin() || resource.data.sender_id == request.auth.uid
      );
    }

    // ----------------------------------------------------------------------
    // NOTIFICATIONS COLLECTION
    // ----------------------------------------------------------------------
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && resource.data.recipient_id == request.auth.uid;

      // Anyone can create a notification (e.g. for mentioning someone)
      allow create: if isAuthenticated();

      // Users can update their own notifications (e.g., marking as read)
      allow update: if isAuthenticated() && resource.data.recipient_id == request.auth.uid;

      // Users can delete their own notifications
      allow delete: if isAuthenticated() && resource.data.recipient_id == request.auth.uid;
    }
  }
}
